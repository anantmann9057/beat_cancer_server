// Environment variables for Vercel deployment
// Copy these to your Vercel dashboard under Project Settings > Environment Variables

NODE_ENV=production
DB_URL=mongodb+srv://username:password@cluster.mongodb.net/beat_cancer_db?retryWrites=true&w=majority
OPENAI_API_KEY=your_openai_api_key_here
ACCESS_TOKEN_SECRET=your_access_token_secret_here
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here
REFRESH_TOKEN_EXPIRY=1d
CORS_ORIGIN=*
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_SECRET_KEY=your_cloudinary_secret_key
CLOUDINARY_URL=your_cloudinary_url

# Note: Don't commit this file to version control
# These are just templates - replace with your actual values in Vercel